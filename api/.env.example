# Copy to .env and fill in values (never commit .env)

DATABASE_URL=

# Server (optional)
# PORT=5000

# Resend — contact form POST /api/contact
RESEND_API_KEY=
# Verified domain sender recommended in production, e.g. Portfolio <hello@yourdomain.com>
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Where contact notifications are delivered
EMAIL_TO=

# Optional — POST /api/collaborate via Gmail / Nodemailer
# EMAIL_USER=
# EMAIL_PASS=

# Comma-separated list of allowed browser origins for CORS.
# The API previously used a bare cors() call, which allows every origin.
# Example: https://tomiwaaluko.com,https://www.tomiwaaluko.com
ALLOWED_ORIGINS=

# Bearer token required by DELETE /api/guestbook/:id.
# That route was previously unauthenticated - anyone could delete any entry.
# Generate with: openssl rand -base64 48
ADMIN_TOKEN=

# Set to "true" to stop sending confirmation emails to form submitters.
# That is the only mail this API sends to a caller-supplied address.
# DISABLE_CONFIRMATION_EMAILS=false

# Set to "true" to expose Swagger UI at /api/docs in production (off by default).
# ENABLE_API_DOCS=false
